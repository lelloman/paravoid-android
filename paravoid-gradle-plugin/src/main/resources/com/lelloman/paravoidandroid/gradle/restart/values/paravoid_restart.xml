<?xml version="1.0" encoding="utf-8"?>
<!--
  Generated by the Paravoid plugin for complete shells with updates enabled.

  Restart screen shown by the shell while it stops and relaunches the app. It runs in the
  payload-free recovery process, so it only uses framework widgets and resources reachable from
  its manifest theme, which keeps them pinned in the shell. To customize it, define a theme
  inheriting Base.Theme.Paravoid.Restart and select it with
  paravoid { updates { restartTheme = '@style/YourTheme' } }. Override framework colors such as
  android:colorBackground, android:colorAccent and text colors, and the paravoidRestart*
  attributes below (point them at your own, translatable strings). %1$s in a text is replaced
  with the app label.
-->
<resources>
    <attr name="paravoidRestartIcon" format="reference" />
    <attr name="paravoidRestartConfirmTitle" format="reference|string" />
    <attr name="paravoidRestartConfirmMessage" format="reference|string" />
    <attr name="paravoidRestartConfirmButton" format="reference|string" />
    <attr name="paravoidRestartDismissButton" format="reference|string" />
    <attr name="paravoidRestartProgressTitle" format="reference|string" />
    <attr name="paravoidRestartProgressMessage" format="reference|string" />
    <attr name="paravoidRestartFailedTitle" format="reference|string" />
    <attr name="paravoidRestartFailedMessage" format="reference|string" />
    <attr name="paravoidRestartCloseButton" format="reference|string" />

    <string name="paravoid_restart_confirm_title">Restart to update?</string>
    <string name="paravoid_restart_confirm_message">%1$s will close and reopen. Ongoing work stops and unsaved changes may be lost. A ready update is applied when it reopens.</string>
    <string name="paravoid_restart_confirm_button">Restart</string>
    <string name="paravoid_restart_dismiss_button">Not now</string>
    <string name="paravoid_restart_progress_title">Restarting %1$s</string>
    <string name="paravoid_restart_progress_message">This only takes a moment.</string>
    <string name="paravoid_restart_failed_title">Restart unavailable</string>
    <string name="paravoid_restart_failed_message">%1$s could not restart. You can try again from the app’s update controls.</string>
    <string name="paravoid_restart_close_button">Close</string>

    <style name="Platform.Theme.Paravoid.Restart" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">?android:attr/colorBackground</item>
        <item name="android:navigationBarColor">?android:attr/colorBackground</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Base.Theme.Paravoid.Restart" parent="Platform.Theme.Paravoid.Restart">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="paravoidRestartConfirmTitle">@string/paravoid_restart_confirm_title</item>
        <item name="paravoidRestartConfirmMessage">@string/paravoid_restart_confirm_message</item>
        <item name="paravoidRestartConfirmButton">@string/paravoid_restart_confirm_button</item>
        <item name="paravoidRestartDismissButton">@string/paravoid_restart_dismiss_button</item>
        <item name="paravoidRestartProgressTitle">@string/paravoid_restart_progress_title</item>
        <item name="paravoidRestartProgressMessage">@string/paravoid_restart_progress_message</item>
        <item name="paravoidRestartFailedTitle">@string/paravoid_restart_failed_title</item>
        <item name="paravoidRestartFailedMessage">@string/paravoid_restart_failed_message</item>
        <item name="paravoidRestartCloseButton">@string/paravoid_restart_close_button</item>
    </style>

    <style name="Theme.Paravoid.Restart" parent="Base.Theme.Paravoid.Restart" />
</resources>
