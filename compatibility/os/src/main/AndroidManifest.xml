<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <permission android:name="${applicationId}.BIND_PROBE" android:protectionLevel="signature" />
    <application android:name=".ProbeApplication" android:label="OS compatibility" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".ProbeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".NotificationReceiver" android:exported="false" />
        <service android:name=".BinderProbeService" android:exported="true"
            android:permission="${applicationId}.BIND_PROBE" />
        <service android:name=".ForegroundProbeService" android:exported="true"
            android:foregroundServiceType="dataSync" android:permission="${applicationId}.BIND_PROBE" />
        <provider android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files" android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/share_paths" />
        </provider>
    </application>
</manifest>
