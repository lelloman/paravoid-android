<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries><package android:name="com.lelloman.paravoidcompat.complete.paravoid"/></queries>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <application android:name=".ProbeApplication" android:label="Paravoid complete fixture" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <receiver android:name=".ProbeReceiver" android:exported="true"/>
        <service android:name=".ProbeService" android:exported="true"/>
        <service android:name=".ProbeService$Foreground" android:foregroundServiceType="dataSync" android:exported="true"/>
        <service android:name=".ProbeService$Worker" android:process=":worker" android:foregroundServiceType="dataSync" android:exported="true"/>
        <service android:name=".ProbeJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true"/>
        <provider android:name=".ProbeProvider" android:authorities="${applicationId}.probe" android:exported="true"/>
        <provider android:name=".ProbeProvider$Worker" android:authorities="${applicationId}.worker" android:process=":worker" android:exported="true"/>
        <provider android:name=".ProbeProvider$Private" android:authorities="${applicationId}.private" android:exported="false"/>
    </application>
</manifest>
